{
  "info": {
    "_postman_id": "e34f5a41-53fa-4c14-9752-aa3f14527219",
    "name": "MD - Lab Test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "user",        "value": "https://apidev.meradoc.com/user",                              "type": "string" },
    { "key": "pharmacy",    "value": "https://apidev.meradoc.com/pharmacy/api/v1/diagnostic/tenant", "type": "string" },
    { "key": "originToken", "value": "ea905fcbecccb788fdde2651cf4ff7d1",                             "type": "string" },
    { "key": "x-api-id",    "value": "PVMD-01",                                                      "type": "string" },
    { "key": "x-api-token", "value": "aZ7tQp3R9mX2bL6vWfH1sE8nYcD4jKu",                             "type": "string" },
    { "key": "accessToken", "value": "",                                                              "type": "string" }
  ],
  "item": [
    {
      "name": "1. Generate Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  var token = pm.response.json().data.token;",
              "  pm.collectionVariables.set('accessToken', token);",
              "  console.log('Access Token saved:', token);",
              "} else {",
              "  console.log('Failed to get token. Code:', pm.response.code);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-api-id",    "value": "{{x-api-id}}",    "type": "text" },
          { "key": "x-api-token", "value": "{{x-api-token}}", "type": "text" },
          { "key": "originToken", "value": "{{originToken}}",  "type": "text" }
        ],
        "url": {
          "raw": "{{user}}/api/v1/sso/tenant",
          "host": ["{{user}}"],
          "path": ["api", "v1", "sso", "tenant"]
        },
        "description": "Generates a short-lived JWT (~1 hour). The test script auto-saves it to the `accessToken` collection variable so all subsequent requests use it automatically."
      },
      "response": []
    },
    {
      "name": "2. Check Serviceability",
      "request": {
        "method": "GET",
        "header": [
          { "key": "originToken",   "value": "{{originToken}}",        "type": "text" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
        ],
        "url": {
          "raw": "{{pharmacy}}/checkServiceability?zipcode=110024&lat=28.6139&long=77.2090",
          "host": ["{{pharmacy}}"],
          "path": ["checkServiceability"],
          "query": [
            { "key": "zipcode", "value": "110024",  "description": "6-digit Indian pincode" },
            { "key": "lat",     "value": "28.6139", "description": "Latitude of delivery address" },
            { "key": "long",    "value": "77.2090", "description": "Longitude of delivery address" }
          ]
        },
        "description": "Checks whether home sample collection is available at a pincode. Returns partner list with zoneId, cityId, stateId — needed for booking."
      },
      "response": []
    },
    {
      "name": "3. Search Lab Tests",
      "request": {
        "method": "GET",
        "header": [
          { "key": "originToken",   "value": "{{originToken}}",        "type": "text" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
        ],
        "url": {
          "raw": "{{pharmacy}}/search?q=thyroid&zipcode=110024&page=1&limit=10",
          "host": ["{{pharmacy}}"],
          "path": ["search"],
          "query": [
            { "key": "q",       "value": "thyroid", "description": "Search keyword — test or package name" },
            { "key": "zipcode", "value": "110024",  "description": "Patient pincode — filters to serviceable tests" },
            { "key": "page",    "value": "1" },
            { "key": "limit",   "value": "10" }
          ]
        },
        "description": "Search lab test packages by keyword. Returns list with _id, name, price, offerPrice, partner, fastingRequired, etc."
      },
      "response": []
    },
    {
      "name": "4. Get Phlebo Slots",
      "request": {
        "method": "POST",
        "header": [
          { "key": "originToken",   "value": "{{originToken}}",        "type": "text" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
          { "key": "Content-Type",  "value": "application/json",       "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"2026-05-26\",\n  \"lat\": \"28.6139\",\n  \"long\": \"77.2090\",\n  \"zipcode\": \"110024\",\n  \"zoneId\": \"3\",\n  \"patients\": [\n    {\n      \"name\": \"Devansh Pandey\",\n      \"gender\": \"MALE\",\n      \"age\": \"22\",\n      \"ageType\": \"YEAR\"\n    }\n  ],\n  \"testList\": [\n    {\n      \"id\": \"AAROGYAM 1 WITH UTSH\",\n      \"type\": \"PACKAGE\",\n      \"name\": \"Aarogyam 1 With Utsh\"\n    }\n  ]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{pharmacy}}/getPhleboSlots",
          "host": ["{{pharmacy}}"],
          "path": ["getPhleboSlots"]
        },
        "description": "Returns available phlebotomist slots for a given date and location.\n\nResponse: `data[].slots[]` — each slot has `id`, `startTime12hr`, `endTime12hr`.\n\n`zoneId` comes from Check Serviceability response."
      },
      "response": []
    },
    {
      "name": "5. Book Lab Test",
      "request": {
        "method": "POST",
        "header": [
          { "key": "originToken",   "value": "{{originToken}}",        "type": "text" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
          { "key": "Content-Type",  "value": "application/json",       "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"partner\": \"thyrocare\",\n  \"patientId\": \"67c6a06d47ad880012d38145\",\n  \"patientName\": \"Devansh Pandey\",\n  \"relation\": \"self\",\n  \"age\": \"22\",\n  \"gender\": \"Male\",\n  \"mobileNumber\": \"9876543210\",\n  \"emailId\": \"devansh@example.com\",\n  \"slotId\": \"3\",\n  \"lat\": \"28.6139\",\n  \"long\": \"77.2090\",\n  \"addressLine1\": \"House 12, Sector 15, Dwarka\",\n  \"addressLine2\": \"Dwarka, New Delhi, Delhi, India, 110078\",\n  \"addressLandmark\": \"Near Metro Station\",\n  \"cityId\": \"3\",\n  \"city\": \"New Delhi\",\n  \"stateId\": \"5\",\n  \"state\": \"Delhi\",\n  \"pincode\": \"110078\",\n  \"offerId\": \"AAROGYAM 1 WITH UTSH\",\n  \"productType\": \"SSKU\",\n  \"packageName\": [\"Aarogyam 1 With Utsh\"],\n  \"packageCode\": [\"AAROGYAM 1 WITH UTSH\"],\n  \"collectionDate\": \"2026-05-26\",\n  \"collectionSlotTime\": \"6:30 AM - 7:00 AM\",\n  \"mrp\": 900,\n  \"discountedPrice\": \"900\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{pharmacy}}/bookLabTest",
          "host": ["{{pharmacy}}"],
          "path": ["bookLabTest"]
        },
        "description": "Books a home collection lab test.\n\n- `patientId` — MeraDoc patient _id from patient registration\n- `slotId` — slot id from Get Phlebo Slots response\n- `cityId` / `stateId` — numeric IDs from Check Serviceability response\n- `offerId` / `packageCode` — test identifier from Search response\n\nSuccess response contains `data.orderId` (e.g. DIAG-753) and `data.orderStatus`."
      },
      "response": []
    },
    {
      "name": "6. Get Order Detail",
      "request": {
        "method": "GET",
        "header": [
          { "key": "originToken",   "value": "{{originToken}}",        "type": "text" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
        ],
        "url": {
          "raw": "{{pharmacy}}/order/DIAG-753",
          "host": ["{{pharmacy}}"],
          "path": ["order", "DIAG-753"]
        },
        "description": "Fetch full order details by human-readable Order ID (e.g. DIAG-753).\nReturns current status, phlebotomist info, collection date/time, and test list."
      },
      "response": []
    },
    {
      "name": "7. Cancel Lab Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "originToken",   "value": "{{originToken}}",        "type": "text" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
          { "key": "Content-Type",  "value": "application/json",       "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"DIAG-753\",\n  \"cancelReason\": \"Patient not available\",\n  \"patientId\": \"67c6a06d47ad880012d38145\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{pharmacy}}/cancelOrder",
          "host": ["{{pharmacy}}"],
          "path": ["cancelOrder"]
        },
        "description": "Cancels a confirmed lab order.\n\n- `orderId` — human-readable ID (e.g. DIAG-753), NOT the MongoDB _id\n- `patientId` — MeraDoc patient _id\n\nNote: Orders in PAYMENT_PENDING status return 400 — cancellation only works after payment is confirmed."
      },
      "response": []
    },
    {
      "name": "8. Reschedule Lab Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "originToken",   "value": "{{originToken}}",        "type": "text" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
          { "key": "Content-Type",  "value": "application/json",       "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"DIAG-753\",\n  \"patientId\": \"67c6a06d47ad880012d38145\",\n  \"appointmentDate\": \"2026-05-27\",\n  \"reasonKey\": \"OTHER\",\n  \"reasonText\": \"Patient unavailable on original date\",\n  \"slotDetails\": {\n    \"slot_id\": \"3\",\n    \"collectionSlot\": \"06:30\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{pharmacy}}/rescheduleOrder",
          "host": ["{{pharmacy}}"],
          "path": ["rescheduleOrder"]
        },
        "description": "Reschedules an existing lab order.\n\n- `orderId` — human-readable ID (e.g. DIAG-753), NOT the MongoDB _id\n- `patientId` — MeraDoc patient _id\n- `slotDetails.slot_id` — slot id from Get Phlebo Slots\n- `slotDetails.collectionSlot` — 24-hour time string (e.g. \"06:30\")\n- `reasonKey` — OPTIONS: OTHER | PATIENT_REQUEST | DOCTOR_UNAVAILABLE"
      },
      "response": []
    }
  ]
}
